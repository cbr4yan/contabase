# Local dev uses an on-disk SQLite file. For Turso, set these to your
# libsql:// URL and auth token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Any long random string. Rotating it logs everyone out. Required in production.
SESSION_SECRET=

# Public /signup (create a company). Disabled unless exactly "true".
# Turn on to register the first company, then turn off.
SIGNUP_ENABLED=false

# Receipt photos. Leave R2_ACCOUNT_ID empty for local dev (files go to ./.uploads).
# In production, set all four for Cloudflare R2:
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
